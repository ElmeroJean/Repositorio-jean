--Avg
SELECT avg(price) as Promedio_del_Precio FROM Products

--Max
SELECT Max(price) as Precio_más_Alto FROM Products

-- Min
SELECT Min(price) as Precio_más_Bajo FROm Products

--Total
SELECT Total(Price) as 'Total' FROM Products

